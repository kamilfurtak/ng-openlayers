{
  "name": "demo-ng-openlayers",
  "scripts": {
    "ng": "ng",
    "start": "nx serve demo-ng-openlayers",
    "build:lib": "nx build ng-openlayers --configuration production",
    "build:lib:dev-watch": "nx build ng-openlayers --configuration production --watch",
    "copy:lib:docs": "cp -r *.md dist/libs/ng-openlayers",
    "build:demo": "nx build demo-ng-openlayers --configuration production --base-href /ng-openlayers/",
    "build:gh-pages": "nx build demo-ng-openlayers --configuration production --output-path docs --base-href /ng-openlayers/",
    "build": "npm run build:lib && npm run build:demo",
    "test": "npm run build:lib && nx test ng-openlayers",
    "test-ci": " nx test ng-openlayers --code-coverage --browsers=ChromeHeadless --watch=false",
    "lint": "nx run-many -t lint",
    "e2e": "npm run build:lib && nx e2e",
    "format": "prettier --write \"**/@(src|e2e)/**/*.ts\"",
    "release": "npm --cwd libs/ng-openlayers release"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "21.2.16",
    "@angular/common": "21.2.16",
    "@angular/compiler": "21.2.16",
    "@angular/core": "21.2.16",
    "@angular/forms": "21.2.16",
    "@angular/platform-browser": "21.2.16",
    "@angular/platform-browser-dynamic": "21.2.16",
    "@angular/router": "21.2.16",
    "hammerjs": "^2.0.8",
    "jsts": "^2.11.3",
    "ngx-toastr": "^20.0.5",
    "ol": "^10.9.0",
    "proj4": "^2.20.8",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.14",
    "@angular-devkit/core": "21.2.14",
    "@angular-devkit/schematics": "21.2.14",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "21.2.14",
    "@angular/compiler-cli": "21.2.16",
    "@angular/language-service": "21.2.16",
    "@nx/angular": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@schematics/angular": "21.2.14",
    "@types/arcgis-rest-api": "^10.4.8",
    "@types/jasmine": "^6.0.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^25.9.2",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@typescript-eslint/utils": "^8.60.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "jasmine-core": "^6.2.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
