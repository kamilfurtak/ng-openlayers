{
  "name": "demo-ng-openlayers",
  "scripts": {
    "ng": "ng",
    "start": "nx serve demo-ng-openlayers",
    "build:lib": "nx build ng-openlayers --configuration production && npm run copy:lib:docs",
    "build:lib:dev-watch": "nx build ng-openlayers --configuration production --watch",
    "copy:lib:docs": "node tools/prepare-package.mjs",
    "build:demo": "nx build demo-ng-openlayers --configuration production --base-href / && node tools/finalize-site.mjs",
    "build:gh-pages": "npm run build:demo",
    "build": "npm run build:lib && npm run build:demo",
    "test": "npm run build:lib && nx run-many -t test --projects=ng-openlayers,demo-ng-openlayers --parallel=1 --watch=false --browsers=ChromeHeadless",
    "test-ci": "nx run-many -t test --projects=ng-openlayers,demo-ng-openlayers --parallel=1 --code-coverage --browsers=ChromeHeadless --watch=false",
    "lint": "nx run-many -t lint",
    "e2e": "npm run build:demo && nx run demo-ng-openlayers-e2e:e2e",
    "format": "prettier --write \"**/@(src|e2e)/**/*.ts\"",
    "release": "nx release",
    "test:consumer": "node tools/verify-consumer.mjs",
    "build:branding": "node tools/build-branding.mjs",
    "e2e:cypress": "npm run build:demo && nx run demo-ng-openlayers-cypress:e2e",
    "test:all": "npm run lint && npm run test-ci && npm run e2e && npm run e2e:cypress && npm run test:consumer",
    "test:watch:lib": "nx test ng-openlayers",
    "test:watch:demo": "nx test demo-ng-openlayers"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/ssr": "22.1.8",
    "ol": "10.10.0",
    "proj4": "2.22.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.1.8",
    "@angular-devkit/schematics": "22.1.8",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "1.63.0",
    "@schematics/angular": "22.1.8",
    "@types/arcgis-rest-api": "10.4.8",
    "@types/jasmine": "6.0.0",
    "@types/node": "^24.0.0",
    "@types/topojson-specification": "1.0.5",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript-eslint/utils": "8.70.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "7.0.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "ng-packagr": "22.1.1",
    "nx": "23.2.1",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "zone.js": "0.16.3",
    "cypress": "16.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "nx": {
      "smol-toml": "1.8.0"
    }
  }
}
